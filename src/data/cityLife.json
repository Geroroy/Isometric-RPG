  "lines": {
    "check": ["정지. 신분 확인하겠습니다. …제다이 장군님이시군요. 실례했습니다.", "코러산트 경비대입니다. 이 구역은 순찰 중입니다, 장군님.", "장군님, 하층은 밤에 위험합니다. 조심하십시오.", "통행 기록 확인. …이상 없습니다. 지나가십시오."],
    "patrolIdle": ["구역 이상 무.", "순찰 계속.", "다음 지점으로 이동."],
    "vendor": ["장군님! 신선한 과일이에요, 오늘 아침에 올라온 거라고요!", "부품 있어요, 부품! 싸게 드려요!", "광선검 손질 기름 있습니다, 장군님!", "잠깐만 보고 가세요, 한 번만요!", "이거 행운의 부적이에요. 전쟁터에선 필요하실걸요?"],
    "low": ["햇빛 본 게 언제였더라…", "윗동네 사람들은 여기가 있는 줄도 몰라.", "제다이가 여기까지 내려오다니, 별일이네.", "공장이 또 문을 닫았어. 전쟁 물자만 찍어 낸다더니.", "저 빛 아래 서 봐. 하루에 몇 분 안 들어와.", "물값이 또 올랐대.", "여기선 아무도 이름을 안 물어봐."],
    "worker": ["교대 끝나면 녹슨 등불에서 한잔하자고.", "오늘도 열두 시간이야.", "감독관 눈에 띄지 마."],
    "drifter": ["크레딧 좀… 아니면 일거리라도.", "전쟁이 끝나면 좀 나아질까?", "날 신경 쓰지 마쇼."],
    "up": ["저 아래 얘기는 그만해요. 식사 자리에서까지.", "의원님 연회 초대장, 받으셨어요?", "제다이 장군님이시다… 전쟁 소식은 좋은가요?", "이 높이에선 공기마저 다르죠.", "전쟁 채권이 또 올랐더군요."],
    "flee": ["광선검이다!", "비켜, 비켜!", "제다이가 칼을 뽑았어!", "무슨 일이야?!", "살려 줘!"],
    "whisper": ["…칼을 켰어.", "무슨 일이 있나 봐.", "가까이 가지 마.", "제다이가 왜 여기서…"],
